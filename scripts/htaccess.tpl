# ============================================================
# VRK Decor, LiteSpeed / Apache rules (generated by scripts/prerender.mjs from scripts/htaccess.tpl)
# ============================================================
Options -Indexes
DirectoryIndex index.html
# Serve /about (not /about/) without the server adding a slash redirect
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. Remove trailing slash (except the home page) AND force https + the main domain, in ONE redirect hop
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^ {{DOMAIN}}%1 [R=301,L]

# 2. Force https, and the main domain (www), in one hop. X-Forwarded-Proto covers hosts behind a proxy or CDN.
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ {{DOMAIN}}%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} !^{{HOST_RX}}$ [NC]
RewriteRule ^ {{DOMAIN}}%{REQUEST_URI} [R=301,L]

# 2b. Direct requests for /index.html and /about/index.html go to the clean URL
RewriteCond %{THE_REQUEST} \s/+(?:(.+?)/)?index\.html[\s?]
RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L,NE]

# 3. Old URLs kept working
RewriteRule ^gallery(/.*)?$ /our-work [R=301,L]
RewriteRule ^packages/?$ /services [R=301,L]
RewriteRule ^quote/?$ /contact [R=301,L]
RewriteRule ^privacy/?$ /privacy-policy [R=301,L]
RewriteRule ^ta/$ /ta [R=301,L]

# 4. Clean URLs: /about serves /about/index.html
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ $1/index.html [L]
</IfModule>

# ---------- Caching ----------
<IfModule mod_headers.c>
  # Hashed build files in /static (CSS, JS, fonts) never change: cache for 1 year
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Photos, logos and video: 30 days
  <FilesMatch "\.(webp|avif|jpe?g|png|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Pages: short cache so updates show quickly
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # ---------- Security headers (safe with the Google Maps embed and WhatsApp links) ----------
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# ---------- Compression (LiteSpeed also applies Brotli automatically when enabled) ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml application/manifest+json image/svg+xml text/markdown
</IfModule>

AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest
AddType text/markdown .md
AddDefaultCharset utf-8
