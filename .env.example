# VRK Decor — environment variable contract
#
# Source of truth: 02_TECHNICAL — Technical Development Specification, section 14.
# This file documents variable NAMES ONLY. Never commit real values.
# Use separate configuration for local, staging and production.

# ---------------------------------------------------------------------------
# Public (exposed to the browser — must contain no secrets)
# ---------------------------------------------------------------------------

# Canonical base URL of the running environment.
# Local: http://localhost:3000  Production: https://vrkdecor.com
NEXT_PUBLIC_SITE_URL=

# Supabase project URL (P3).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/publishable key (P3). Safe for the browser only because
# Row Level Security is enforced on every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Analytics measurement ID (P9), e.g. G-XXXXXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Server-only (must NEVER be prefixed with NEXT_PUBLIC_ or reach the browser)
# ---------------------------------------------------------------------------

# Supabase service-role key (P3). Server-side use only. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp click-to-chat number in international format, e.g. +919994072435 (P7).
WHATSAPP_PHONE_NUMBER=

# Transactional email provider credentials for the customer confirmation email
# (P7). Provider selection is an open decision — see 09_DECISIONS/DECISIONS.md.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# ---------------------------------------------------------------------------
# Test-only (never set in staging or production)
# ---------------------------------------------------------------------------

# PostgreSQL connection string for the database/RLS test suite. The suite drops
# and recreates this database on every run, so it must be a throwaway instance.
# Never point it at staging or production.
TEST_DATABASE_URL=
